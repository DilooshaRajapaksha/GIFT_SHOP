# Copy this file to .env and fill in your own values
DB_USERNAME=root
DB_PASSWORD=your-mysql-password
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
IMAGE_DIR=uploads/images
# password for the /admin page
ADMIN_PASSWORD=choose-an-admin-password
# secret for signing admin login tokens (long random text)
JWT_SECRET=any-long-random-text-at-least-32-characters
# websites allowed to call the API (add your real domain later)
ALLOWED_ORIGINS=http://localhost:5173
